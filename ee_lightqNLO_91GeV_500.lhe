      5 4.700000e+00 # mb                                                                                                                                                                                                                                 
      6 1.730000e+02 # mt                                                                                                                                                                                                                                 
      15 1.777000e+00 # mta                                                                                                                                                                                                                               
      23 9.118800e+01 # mz                                                                                                                                                                                                                                
      25 1.250000e+02 # mh                                                                                                                                                                                                                                
      1 0.000000e+00 # d : 0.0                                                                                                                                                                                                                            
