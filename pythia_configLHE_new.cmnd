! 1) Settings used in the main program.

Main:numberOfEvents = 1000000  !it is set to 1 million events so that i dont have to change it again and again 
Random:setSeed = on
Main:timesAllowErrors = 5          ! how many aborts before run stops
PDF:lepton = on



! 2) Settings related to output in init(), next() and stat().

Init:showChangedSettings = on      ! list changed settings
Init:showChangedParticleData = off ! list changed particle data
Next:numberCount = 10             ! print message every n events
Next:numberShowInfo = 1            ! print event information n times
Next:numberShowProcess = 1         ! print process record n times
Next:numberShowEvent = 0           ! print event record n times



! 3) Beam parameter settings.
!These explicitly force Pythia to recognize the incoming beams as an electron and a positron. If omitted, Pythia defaults to LHC-style proton collisions and will violently crash when the LHE file math doesn't match.

Beams:idA = 11                   ! first beam, electron
Beams:idB = -11                  ! second beam, positron
Beams:allowMomentumSpread  = off



! Vertex smearing :

Beams:allowVertexSpread = on
Beams:sigmaVertexX = 5.96e-3   
Beams:sigmaVertexY = 23.8E-6 
Beams:sigmaVertexZ = 0.397     
Beams:sigmaTime = 10.89    !  36.3 ps



! 4) Tell Pythia that LHEF input is used
Beams:frameType             = 4 !Tell Pythia that it should be reading an external LHE file rather than generating its own events from scratch

Beams:LHEF                 = LHE_Files/ee_lightjetsNLO_50k_45GeV_26may.lhe     !The path to your LHE file
Beams:setProductionScalesFromLHEF = off
Check:epTolErr               = 1e-2



! 5) Hard process : Z->qqbar at Ecm=91 GeV

 Beams:eCM = 91.118  ! CM energy of collision
 PartonLevel:ISR = on               ! initial-state radiation
 PartonLevel:FSR = on               ! final-state radiation

